{
  "name": "dsh-pm-workbench",
  "version": "2.5.0",
  "type": "module",
  "license": "MIT",
  "dependencies": {
    "imapflow": "^2.12.1",
    "mailparser": "^3.14.4"
  },
  "author": "kieran.wang (https://github.com/wangkang183)",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "todo",
    "workbench",
    "memo",
    "inbox",
    "qq-mail"
  ],
  "description": "PM workbench in the right sidebar: memos, projects with Gantt, a read-only QQ Mail inbox, calendar, AI weekly digest, and host tools for WeChat/IM access.",
  "repository": {
    "type": "git",
    "url": "https://github.com/wangkang183/dsh-pm-workbench.git"
  },
  "homepage": "https://github.com/wangkang183/dsh-pm-workbench#readme",
  "bugs": {
    "url": "https://github.com/wangkang183/dsh-pm-workbench/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "store.js",
    "tools.js",
    "inbox.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar-right"]
    }
  }
}
